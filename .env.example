# 노션 연동 환경변수 (서버 전용, NEXT_PUBLIC_ 접두사를 붙이지 않는다)
# 실제 값은 .env.local에 적고 이 파일에는 값을 쓰지 않는다.
NOTION_API_KEY=
NOTION_DATABASE_ID=
# 발행자 정보 (견적서 화면과 PDF에 표시된다)
ISSUER_NAME=
ISSUER_CONTACT=
# 견적서 조회 캐시 유지 시간(초). 비우면 3600(1시간). 테스트에서만 짧게 바꾼다.
NOTION_CACHE_TTL_SECONDS=

# 관리자 화면 (서버 전용, NEXT_PUBLIC_ 접두사를 붙이지 않는다)
# 관리자 로그인 비밀번호
ADMIN_PASSWORD=
# 세션 쿠키 서명 시크릿. 32자 이상의 무작위 문자열 (예: openssl rand -base64 48)
ADMIN_SESSION_SECRET=
# 공유 링크 기준 주소 (예: https://example.com). 비우면 관리자가 접속한 주소를 쓴다.
NEXT_PUBLIC_APP_URL=
